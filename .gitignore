.venv/
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo

# Python 打包产物
*.egg-info/
dist/
build/

# 测试缓存
.pytest_cache/

# 类型检查 / Linter 缓存
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

diff.*

input/*
output/*
data/*.db*
data/backups/*

!input/.gitkeep
!output/.gitkeep
!data/backups/.gitkeep

.coverage

# ===== npm / 前端 =====
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tmp*

certs/

# patch 命令
*.orig
*.rej

*.swp
opencode.json

# ===== 部署运行时产物 =====
data/.env
data/.xfunnote.pid
data/.xfunnote.log

# ===== 打包产物 =====
*.deb
*.apk
*.aab
*.keystore

# ===== Android (Chaquopy / Gradle) =====
deploy/android/.gradle/
deploy/android/.kotlin/
deploy/android/build/
deploy/android/local.properties
deploy/android/app/build/
deploy/android/app/.cxx/
