#!/bin/sh
set -e

# 创建系统用户
adduser --system --group --no-create-home xfunnote || true

# 创建虚拟环境并安装依赖
python3 -m venv /opt/xfunnote/.venv
/opt/xfunnote/.venv/bin/pip install --no-cache-dir -r /opt/xfunnote/backend/requirements.txt uvicorn

# 数据目录权限
mkdir -p /var/lib/xfunnote
chown -R xfunnote:xfunnote /opt/xfunnote /var/lib/xfunnote

# 部署 nginx 配置：HTTP + HTTPS 模板
cp /opt/xfunnote/deploy/linux/nginx-http.conf /etc/nginx/sites-available/xfunnote-http.conf
cp /opt/xfunnote/deploy/linux/nginx-https.conf.template /etc/nginx/sites-available/xfunnote-https.conf.template

# 默认启用 HTTP 模式
ln -sf /etc/nginx/sites-available/xfunnote-http.conf /etc/nginx/sites-enabled/xfunnote

nginx -t && systemctl reload nginx || true

# 安装并启动 systemd 服务
systemctl daemon-reload
systemctl enable xfunnote
systemctl start xfunnote

echo "⚠️ 安装完成。默认运行 HTTP 模式（端口 80）"
echo "   如需启用 HTTPS："
echo "   sudo /opt/xfunnote/deploy/linux/switch-nginx-mode.sh https --cert-path /path/to/cert.pem --key-path /path/to/key.pem"